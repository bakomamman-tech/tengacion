  "lifecycleDefinitions": {
    "production": "Persistent, user-meaningful workflow with no fabricated state.",
    "beta": "Server-backed workflow with material controls or operational coverage still incomplete.",
    "preview": "Non-production surface that must not be promoted as an available workflow.",
    "experimental": "Working but deliberately limited or non-core experience.",
    "internal": "Restricted staff or administrative workflow.",
    "alias": "Redirect or compatibility path for another canonical route."
